# Copy to .env.local (or set in Vercel). Never commit real values. See docs/SETUP.md.
NEXT_PUBLIC_SITE_URL=https://okwan.ai

# Supabase: the Vercel integration's names work too (…_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gemini (paid tier). Verify model ids at https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# Tried in order when the Flash model is overloaded (503/429).
# GEMINI_FLASH_FALLBACKS=gemini-3.7-flash,gemini-3.5-flash
# Cedis per US dollar for converting bank statement balances (the user confirms the result).
# FX_GHS_PER_USD=11.5
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Paystack (sk_test_… first)
PAYSTACK_SECRET_KEY=

# Vercel Cron auth for /api/cron/cleanup
CRON_SECRET=
